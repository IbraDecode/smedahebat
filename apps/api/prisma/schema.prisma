generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SISWA
  GURU
  WALI_KELAS
  BK
  TU
  ADMIN
  KEPALA_SEKOLAH
}

enum Gender {
  L
  P
}

model School {
  id        String   @id @default(cuid())
  name      String
  address   String?
  phone     String?
  email     String?
  website   String?
  logo      String?
  npsn      String?  @unique
  status    String   @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users         User[]
  academicYears AcademicYear[]
  grades        Grade[]
  classes       Class[]
  subjects      Subject[]
  teacherSubjects TeacherSubject[]
}

model AcademicYear {
  id        String   @id @default(cuid())
  schoolId  String
  year      String
  semester  Int      @default(1)
  isActive  Boolean  @default(false)
  startDate DateTime
  endDate   DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  users  User[]

  @@index([schoolId])
  @@unique([schoolId, year, semester])
}

model User {
  id             String        @id @default(cuid())
  nis            String        @unique
  nip            String?       @unique
  name           String
  email          String?       @unique
  password       String
  role           Role          @default(SISWA)
  gender         Gender?
  phone          String?
  address        String?
  photo          String?
  birthDate      DateTime?
  birthPlace     String?
  isActive       Boolean       @default(true)
  isFirstLogin   Boolean       @default(true)
  lastLogin      DateTime?
  schoolId       String?
  academicYearId String?
  classId        String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  sessions      Session[]
  refreshTokens RefreshToken[]
  school        School?       @relation(fields: [schoolId], references: [id])
  academicYear  AcademicYear? @relation(fields: [academicYearId], references: [id])
  class         Class?        @relation(fields: [classId], references: [id])
  teacherSubjects TeacherSubject[]

  @@index([role])
  @@index([nis])
  @@index([isActive])
  @@index([schoolId])
  @@index([academicYearId])
  @@index([classId])
}

model Grade {
  id          String   @id @default(cuid())
  schoolId    String
  name        String   // e.g. "X", "XI", "XII"
  alias       String?  // e.g. "10", "11", "12"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classes     Class[]

  @@unique([schoolId, name])
  @@index([schoolId])
}

model Class {
  id          String   @id @default(cuid())
  schoolId    String
  gradeId     String
  name        String   // e.g. "X RPL 1", "XI AKL 2"
  code        String?  @unique // e.g. "X-RPL-1"
  room        String?
  capacity    Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  grade       Grade    @relation(fields: [gradeId], references: [id], onDelete: Cascade)
  users       User[]
  teacherSubjects TeacherSubject[]

  @@unique([schoolId, name])
  @@index([schoolId])
  @@index([gradeId])
}

model Subject {
  id          String   @id @default(cuid())
  schoolId    String
  name        String   // e.g. "Matematika", "Bahasa Indonesia"
  code        String?  // e.g. "MTK", "BINDO"
  category    String?  // e.g. "Wajib", "Peminatan", "Muatan Lokal"
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  teacherSubjects TeacherSubject[]

  @@unique([schoolId, name])
  @@index([schoolId])
}

enum Day {
  SENIN
  SELASA
  RABU
  KAMIS
  JUMAT
  SABTU
}

model TeacherSubject {
  id          String   @id @default(cuid())
  teacherId   String
  subjectId   String
  classId     String
  schoolId    String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  teacher     User     @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  subject     Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  class       Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  schedules   Schedule[]
  @@unique([teacherId, subjectId, classId])
  @@index([teacherId])
  @@index([subjectId])
  @@index([classId])
  @@index([schoolId])
}

model Schedule {
  id                String   @id @default(cuid())
  teacherSubjectId  String
  day               Day
  startTime         String   // "07:30"
  endTime           String   // "08:15"
  room              String?
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  teacherSubject    TeacherSubject @relation(fields: [teacherSubjectId], references: [id], onDelete: Cascade)

  @@index([teacherSubjectId])
  @@index([day])
}

model Session {
  id         String   @id @default(cuid())
  userId     String
  token      String   @unique
  deviceInfo String?
  ipAddress  String?
  isActive   Boolean  @default(true)
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
}

model RefreshToken {
  id         String   @id @default(cuid())
  userId     String
  token      String   @unique
  isActive   Boolean  @default(true)
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
}
