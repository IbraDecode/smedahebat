generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SISWA
  GURU
  WALI_KELAS
  BK
  TU
  ADMIN
  KEPALA_SEKOLAH
}

enum Gender {
  L
  P
}

model User {
  id           String   @id @default(cuid())
  nis          String   @unique
  nip          String?  @unique
  name         String
  email        String?  @unique
  password     String
  role         Role     @default(SISWA)
  gender       Gender?
  phone        String?
  address      String?
  photo        String?
  birthDate    DateTime?
  birthPlace   String?
  isActive     Boolean  @default(true)
  isFirstLogin Boolean  @default(true)
  lastLogin    DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sessions      Session[]
  refreshTokens RefreshToken[]

  @@index([role])
  @@index([nis])
  @@index([isActive])
}

model Session {
  id         String   @id @default(cuid())
  userId     String
  token      String   @unique
  deviceInfo String?
  ipAddress  String?
  isActive   Boolean  @default(true)
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
}

model RefreshToken {
  id         String   @id @default(cuid())
  userId     String
  token      String   @unique
  isActive   Boolean  @default(true)
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
}
