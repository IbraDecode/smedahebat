generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SISWA
  GURU
  WALI_KELAS
  BK
  TU
  ADMIN
  KEPALA_SEKOLAH
}

enum Gender {
  L
  P
}

model School {
  id        String   @id @default(cuid())
  name      String
  address   String?
  phone     String?
  email     String?
  website   String?
  logo      String?
  npsn      String?  @unique
  status    String   @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users         User[]
  academicYears AcademicYear[]
  grades        Grade[]
  classes       Class[]
  subjects      Subject[]
  teacherSubjects TeacherSubject[]
  announcements Announcement[]
  assignments    Assignment[]
}

model AcademicYear {
  id        String   @id @default(cuid())
  schoolId  String
  year      String
  semester  Int      @default(1)
  isActive  Boolean  @default(false)
  startDate DateTime
  endDate   DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  users  User[]
  gradeComponents GradeComponent[]
  reportCards     ReportCard[]

  @@index([schoolId])
  @@unique([schoolId, year, semester])
}

model User {
  id             String        @id @default(cuid())
  nis            String        @unique
  nip            String?       @unique
  name           String
  email          String?       @unique
  password       String
  role           Role          @default(SISWA)
  gender         Gender?
  phone          String?
  address        String?
  photo          String?
  birthDate      DateTime?
  birthPlace     String?
  isActive       Boolean       @default(true)
  isFirstLogin   Boolean       @default(true)
  lastLogin      DateTime?
  schoolId       String?
  academicYearId String?
  classId        String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  sessions      Session[]
  refreshTokens RefreshToken[]
  school        School?       @relation(fields: [schoolId], references: [id])
  academicYear  AcademicYear? @relation(fields: [academicYearId], references: [id])
  class         Class?        @relation(fields: [classId], references: [id])
  teacherSubjects TeacherSubject[]
  attendanceSessions AttendanceSession[]
  attendances       Attendance[]
  announcements     Announcement[]     @relation("UserAnnouncements")
  announcementReads AnnouncementRead[]
  notifications     Notification[]
  teacherAssignments Assignment[]      @relation("TeacherAssignments")
  submissions        Submission[]      @relation("StudentSubmissions")
  scores             Score[]
  reportCards        ReportCard[]

  @@index([role])
  @@index([nis])
  @@index([isActive])
  @@index([schoolId])
  @@index([academicYearId])
  @@index([classId])
}

model Grade {
  id          String   @id @default(cuid())
  schoolId    String
  name        String   // e.g. "X", "XI", "XII"
  alias       String?  // e.g. "10", "11", "12"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classes     Class[]

  @@unique([schoolId, name])
  @@index([schoolId])
}

model Class {
  id          String   @id @default(cuid())
  schoolId    String
  gradeId     String
  name        String   // e.g. "X RPL 1", "XI AKL 2"
  code        String?  @unique // e.g. "X-RPL-1"
  room        String?
  capacity    Int?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  grade       Grade    @relation(fields: [gradeId], references: [id], onDelete: Cascade)
  users       User[]
  teacherSubjects TeacherSubject[]
  attendanceSessions AttendanceSession[]
  announcements Announcement[]
  assignments    Assignment[]
  gradeComponents   GradeComponent[]
  reportCards       ReportCard[]

  @@unique([schoolId, name])
  @@index([schoolId])
  @@index([gradeId])
}

model Subject {
  id          String   @id @default(cuid())
  schoolId    String
  name        String   // e.g. "Matematika", "Bahasa Indonesia"
  code        String?  // e.g. "MTK", "BINDO"
  category    String?  // e.g. "Wajib", "Peminatan", "Muatan Lokal"
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  teacherSubjects TeacherSubject[]
  attendanceSessions AttendanceSession[]
  assignments        Assignment[]
  gradeComponents    GradeComponent[]
  reportCardSubjects ReportCardSubject[]

  @@unique([schoolId, name])
  @@index([schoolId])
}

enum Day {
  SENIN
  SELASA
  RABU
  KAMIS
  JUMAT
  SABTU
}

model TeacherSubject {
  id          String   @id @default(cuid())
  teacherId   String
  subjectId   String
  classId     String
  schoolId    String
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  teacher     User     @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  subject     Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  class       Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  school      School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  schedules   Schedule[]
  @@unique([teacherId, subjectId, classId])
  @@index([teacherId])
  @@index([subjectId])
  @@index([classId])
  @@index([schoolId])
}

model Schedule {
  id                String   @id @default(cuid())
  teacherSubjectId  String
  day               Day
  startTime         String   // "07:30"
  endTime           String   // "08:15"
  room              String?
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  teacherSubject    TeacherSubject @relation(fields: [teacherSubjectId], references: [id], onDelete: Cascade)
  attendanceSessions AttendanceSession[]

  @@index([teacherSubjectId])
  @@index([day])
}

model Session {
  id         String   @id @default(cuid())
  userId     String
  token      String   @unique
  deviceInfo String?
  ipAddress  String?
  isActive   Boolean  @default(true)
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
}

model RefreshToken {
  id         String   @id @default(cuid())
  userId     String
  token      String   @unique
  isActive   Boolean  @default(true)
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@index([expiresAt])
}

enum AttendanceStatus {
  HADIR
  SAKIT
  IZIN
  ALPA
  TERLAMBAT
}

model AttendanceSession {
  id          String   @id @default(cuid())
  teacherId   String
  scheduleId  String?
  classId     String
  subjectId   String?
  token       String   @unique
  expiresAt   DateTime
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  teacher     User     @relation(fields: [teacherId], references: [id])
  schedule    Schedule? @relation(fields: [scheduleId], references: [id])
  class       Class    @relation(fields: [classId], references: [id])
  subject     Subject? @relation(fields: [subjectId], references: [id])

  attendances Attendance[]

  @@index([token])
  @@index([teacherId])
  @@index([classId])
  @@index([isActive])
}

model Attendance {
  id          String           @id @default(cuid())
  sessionId   String
  userId      String
  status      AttendanceStatus @default(HADIR)
  timestamp   DateTime         @default(now())
  latitude    Float?
  longitude   Float?
  note        String?
  createdAt   DateTime         @default(now())

  session     AttendanceSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user        User             @relation(fields: [userId], references: [id])

  @@unique([sessionId, userId])
  @@index([userId])
  @@index([sessionId])
}

enum AnnouncementTarget {
  ALL
  SISWA
  GURU
  WALI_KELAS
  KELAS
}

model Announcement {
  id          String             @id @default(cuid())
  schoolId    String
  authorId    String
  title       String
  content     String
  target      AnnouncementTarget @default(ALL)
  classId     String?
  isPinned    Boolean            @default(false)
  isActive    Boolean            @default(true)
  attachment  String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  school      School             @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  author      User               @relation("UserAnnouncements", fields: [authorId], references: [id])
  class       Class?             @relation(fields: [classId], references: [id])

  reads       AnnouncementRead[]

  @@index([schoolId])
  @@index([authorId])
  @@index([target])
  @@index([createdAt])
}

model AnnouncementRead {
  id             String       @id @default(cuid())
  announcementId String
  userId         String
  readAt         DateTime     @default(now())

  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id])

  @@unique([announcementId, userId])
  @@index([userId])
}

model Assignment {
  id              String    @id @default(cuid())
  schoolId        String
  teacherId       String
  subjectId       String
  classId         String
  title           String
  description     String?
  attachment      String?
  maxScore        Int       @default(100)
  deadline        DateTime
  isActive        Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  school          School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  teacher         User      @relation("TeacherAssignments", fields: [teacherId], references: [id])
  subject         Subject   @relation(fields: [subjectId], references: [id])
  class           Class     @relation(fields: [classId], references: [id])

  submissions     Submission[]

  @@index([schoolId])
  @@index([teacherId])
  @@index([classId])
  @@index([deadline])
}

model Submission {
  id              String   @id @default(cuid())
  assignmentId    String
  studentId       String
  content         String?
  attachment      String?
  score           Int?
  feedback        String?
  isLate          Boolean  @default(false)
  submittedAt     DateTime @default(now())
  gradedAt        DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  assignment      Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student         User       @relation("StudentSubmissions", fields: [studentId], references: [id])

  @@unique([assignmentId, studentId])
  @@index([assignmentId])
  @@index([studentId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  body      String
  type      String
  referenceId String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
}

model GradeComponent {
  id              String   @id @default(cuid())
  subjectId       String
  classId         String
  academicYearId  String
  name            String   // "Tugas Harian 1", "UTS", "UAS", "Praktik"
  type            String   // "tugas", "uts", "uas", "praktik"
  weight          Int      @default(100)
  maxScore        Int      @default(100)
  description     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  subject         Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  class           Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  academicYear    AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  scores          Score[]

  @@index([subjectId])
  @@index([classId])
  @@index([academicYearId])
}

model Score {
  id                String   @id @default(cuid())
  componentId       String
  studentId         String
  score             Float
  notes             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  component         GradeComponent @relation(fields: [componentId], references: [id], onDelete: Cascade)
  student           User           @relation(fields: [studentId], references: [id])

  @@unique([componentId, studentId])
  @@index([studentId])
}

model ReportCard {
  id              String   @id @default(cuid())
  studentId       String
  classId         String
  academicYearId  String
  semester        Int      @default(1)
  totalScore      Float?
  averageScore    Float?
  rank            Int?
  notes           String?
  isPublished      Boolean  @default(false)
  publishedAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  student         User           @relation(fields: [studentId], references: [id])
  class           Class          @relation(fields: [classId], references: [id], onDelete: Cascade)
  academicYear    AcademicYear   @relation(fields: [academicYearId], references: [id], onDelete: Cascade)

  subjects        ReportCardSubject[]

  @@unique([studentId, classId, academicYearId, semester])
  @@index([studentId])
  @@index([classId])
}

model ReportCardSubject {
  id              String   @id @default(cuid())
  reportCardId    String
  subjectId       String
  totalScore      Float
  averageScore    Float
  grade           String?  // A, B, C, D, E
  description     String?  // "Baik", "Cukup", etc.
  teacherNotes    String?
  createdAt       DateTime @default(now())

  reportCard      ReportCard @relation(fields: [reportCardId], references: [id], onDelete: Cascade)
  subject         Subject    @relation(fields: [subjectId], references: [id])

  @@unique([reportCardId, subjectId])
  @@index([reportCardId])
}
